# Copy to .env (git-ignored) and fill in. Run benchmarks with:
#   node --env-file=.env bench/probe.mjs

# Any OpenAI-compatible endpoint
VERIQUOTE_JUDGE_API_KEY=
VERIQUOTE_BASE_URL=https://openrouter.ai/api/v1

# Defaults for the benchmark runners (override with --model / --models)
VERIQUOTE_JUDGE_MODEL=qwen3.6-35b-a3b
VERIQUOTE_MODELS=glm-5.3-flash,qwen3.5-397b-a17b,deepseek-v4-flash-0731,mistral-medium-3.5-128b,gemma-4-31b-it
