{
  "name": "veriquote",
  "version": "0.1.1",
  "description": "Deterministic + semantic verification of quote-grounded LLM citations (EVI1 protocol): fuzzy verbatim-quote matching and an LLM entailment judge for transparent, per-claim hallucination detection.",
  "keywords": [
    "llm",
    "rag",
    "citations",
    "hallucination",
    "groundedness",
    "verification",
    "nli",
    "entailment",
    "fact-checking",
    "attribution"
  ],
  "license": "MIT",
  "author": "NavigNine (https://navignine.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/rickintoplace/veriquote.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CITATION.cff"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
